# Normalisasi akhiran baris. Skrip shell dan berkas konfigurasi container
# WAJIB berakhiran LF — CRLF membuat Linux menolaknya dengan
# "bad interpreter: /bin/sh^M".
* text=auto eol=lf

*.sh          text eol=lf
Dockerfile    text eol=lf
*.conf        text eol=lf
*.ini         text eol=lf

# Berkas biner jangan diutak-atik.
*.png binary
*.jpg binary
*.woff binary
*.woff2 binary
